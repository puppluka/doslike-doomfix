#include <windows.h>

#define STRINGIFY(x)    #x
#define TOSTRING(x)     STRINGIFY(x)

#define MAJOR			0
#define MINOR			5
#define BUILD			0
#define PATCH			0

#define VERSION_STRING  TOSTRING(MAJOR) "." TOSTRING(MINOR) "." TOSTRING(BUILD) "." TOSTRING(PATCH)
#define DEV_ID          "Aerox Software"
	
#define PRODUCT_ID		"AexDoom"
#define FILE_NAME		PRODUCT_ID ".exe"

1		ICON			"icon.ico"

// Links an application manifest (ID 1, Type 24 = RT_MANIFEST)
// Required for DPI-awareness and UAC virtualization bypass
1		24				"resource.manifest"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    MAJOR, MINOR, BUILD, PATCH
    PRODUCTVERSION MAJOR, MINOR, BUILD, PATCH
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0x0L					// Use VS_FF_DEBUG for debug builds
    FILEOS         VOS_NT_WINDOWS32		// Win32/Win64 App Standard
    FILETYPE       VFT_APP				// Is an Executable
    FILESUBTYPE	   VFT2_UNKNOWN

BEGIN

    BLOCK "StringFileInfo"

		BEGIN
			BLOCK "040904b0"
			BEGIN
				VALUE "CompanyName",      DEV_ID
				VALUE "FileDescription",  "DOS-Faithful Enhanced Doom Port"
				VALUE "FileVersion",      VERSION_STRING
				VALUE "InternalName",     PRODUCT_ID
				VALUE "LegalCopyright",   "Copyright \251 2026 " DEV_ID
				VALUE "OriginalFilename", FILE_NAME
				VALUE "ProductName",      PRODUCT_ID
				VALUE "ProductVersion",   VERSION_STRING
			END
		END

	BLOCK "VarFileInfo"
		BEGIN
			VALUE "Translation",	0x409,		1200
		END

END